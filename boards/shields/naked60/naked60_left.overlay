#include <dt-bindings/zmk/matrix_transform.h>
#include "layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan_composite;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        rows = <5>;
        columns = <12>;

        main {
            kscan = <&kscan_main>;
        };

        rows12 {
            kscan = <&kscan_rows12>;
            row-offset = <1>;
        };
    };

    kscan_main: kscan_main {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row0: P0.9  */
            ,<&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row1ダミー(PIN2) */
            ,<&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row2ダミー */
            ,<&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row3: P0.19 */
            ,<&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* Row4: P0.20 */
            ;

        col-gpios
            = <&gpio0 5  GPIO_ACTIVE_HIGH>
            ,<&gpio0 0  GPIO_ACTIVE_HIGH>
            ,<&gpio0 30 GPIO_ACTIVE_HIGH>
            ,<&gpio0 3  GPIO_ACTIVE_HIGH>
            ,<&gpio1 14 GPIO_ACTIVE_HIGH>
            ,<&gpio1 15 GPIO_ACTIVE_HIGH>
            ,<&gpio0 10 GPIO_ACTIVE_HIGH>
            ,<&gpio0 22 GPIO_ACTIVE_HIGH>
            ,<&gpio0 23 GPIO_ACTIVE_HIGH>
            ,<&gpio1 0  GPIO_ACTIVE_HIGH>
            ,<&gpio1 3  GPIO_ACTIVE_HIGH>
            ,<&gpio0 8  GPIO_ACTIVE_HIGH>
            ;
    };

    kscan_rows12: kscan_rows12 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 18 GPIO_ACTIVE_LOW> /* Row1: P0.18 */
            ,<&gpio0 16 GPIO_ACTIVE_LOW> /* Row2: P0.16 */
            ;

        col-gpios
            = <&gpio0 5  GPIO_ACTIVE_LOW>
            ,<&gpio0 0  GPIO_ACTIVE_LOW>
            ,<&gpio0 30 GPIO_ACTIVE_LOW>
            ,<&gpio0 3  GPIO_ACTIVE_LOW>
            ,<&gpio1 14 GPIO_ACTIVE_LOW>
            ,<&gpio1 15 GPIO_ACTIVE_LOW>
            ,<&gpio0 10 GPIO_ACTIVE_LOW>
            ,<&gpio0 22 GPIO_ACTIVE_LOW>
            ,<&gpio0 23 GPIO_ACTIVE_LOW>
            ,<&gpio1 0  GPIO_ACTIVE_LOW>
            ,<&gpio1 3  GPIO_ACTIVE_LOW>
            ,<&gpio0 8  GPIO_ACTIVE_LOW>
            ;
    };
};

&physical_layout0 {
    kscan = <&kscan_composite>;
    transform = <&default_transform>;
};